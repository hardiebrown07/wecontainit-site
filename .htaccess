# Contain-It static site — Apache config
# Clean URLs: /storages serves storages.html; .html addresses 301 to the clean form.
# NOTE: /old/ (archived WordPress) has its own .htaccess, these rewrites don't apply there.

DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes

RewriteEngine On

# force https + non-www, single hop
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://wecontainit.co.uk%{REQUEST_URI} [R=301,L]

# homepage aliases -> /
RewriteRule ^index(\.html)?$ / [R=301,L]

# legacy WordPress sitemap page
RewriteRule ^sitemap\.html$ /sitemap.xml [R=301,L]

# 301s from old WordPress URLs (with and without trailing slash)
RewriteRule ^about-us/?$ /locations [R=301,L]
RewriteRule ^contact-us/?$ /contact [R=301,L]
RewriteRule ^gallery/?$ /storages [R=301,L]
RewriteRule ^order-online/?$ /storages [R=301,L]
RewriteRule ^product-category/storage/?$ /storages [R=301,L]
RewriteRule ^product/storage/?$ /storages [R=301,L]
RewriteRule ^cart/?$ /storages [R=301,L]
RewriteRule ^checkout/?$ /contact [R=301,L]
RewriteRule ^google-review/?$ /contact [R=301,L]
RewriteRule ^hello-world/?$ / [R=301,L]
RewriteRule ^self-storage-glasgow/?$ /glasgow [R=301,L]
RewriteRule ^self-storage-paisley/?$ /paisley [R=301,L]

# discontinued page
RewriteRule ^vehicle-storage(\.html)?/?$ /storages [R=301,L]

# review card short links (302 so we can re-point without stale caches)
RewriteRule ^review-glasgow/?$ https://g.page/r/CddRCxb8NySPEBM/review [R=302,L]
RewriteRule ^review-paisley/?$ https://g.page/r/CbqR52XTVF0KEBM/review [R=302,L]
RewriteRule ^review/?$ https://g.page/r/CddRCxb8NySPEBM/review [R=302,L]

# strip trailing slash on non-directories (/faq/ -> /faq)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /page.html -> /page (direct requests only, internal rewrites untouched)
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# serve /page from page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# --- caching: images/video long, css/js medium, HTML always fresh ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- archived WordPress at /old/: keep out of Google, wp-admin still works ---
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/old/" OLDSITE
  Header set X-Robots-Tag "noindex, nofollow" env=OLDSITE
</IfModule>
